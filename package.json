{
  "name": "martx-monorepo",
  "version": "1.0.0",
  "description": "MART.X MERN Stack E-Commerce Platform Monorepo",
  "main": "server/src/server.js",
  "scripts": {
    "postinstall": "npm --prefix server install",
    "build": "npm --prefix server install",
    "start": "node server/src/server.js",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "dev": "npm run start:server & npm run start:client"
  },
